# Шаблон конфигурации SMTP. Скопируй в email.properties и подставь свои значения.
# email.properties — в .gitignore.
# Любое значение можно перекрыть env-переменной (ключ перед двоеточием).

email.username=${EMAIL_USERNAME:your_email@example.com}
email.password=${EMAIL_PASSWORD:your_email_app_password}
email.from=${EMAIL_FROM:your_email@example.com}

mail.smtp.host=${MAIL_SMTP_HOST:smtp.gmail.com}
mail.smtp.port=${MAIL_SMTP_PORT:587}
mail.smtp.auth=${MAIL_SMTP_AUTH:true}
mail.smtp.starttls.enable=${MAIL_SMTP_STARTTLS_ENABLE:true}
